* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #121214;
    color: #ffffff;
}

.calculator {
    width: 320px;
    background-color: #1e1e24;
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.display {
    background-color: #121214;
    border-radius: 12px;
    padding: 20px;
    text-align: right;
    margin-bottom: 20px;
    min-height: 90px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    word-wrap: break-word;
    word-break: break-all;
}

#previous-operation {
    color: #7a7a8c;
    font-size: 0.9rem;
    min-height: 18px;
}

#current-operation {
    font-size: 2rem;
    font-weight: 600;
}

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.btn {
    border: none;
    background-color: #2a2a32;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 500;
    padding: 18px;
    border-radius: 12px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

.btn:hover {
    background-color: #3a3a45;
}

.btn:active {
    transform: scale(0.95);
}

.btn.operator {
    background-color: #4f46e5;
    color: #ffffff;
}

.btn.operator:hover {
    background-color: #6366f1;
}

.btn.clear {
    background-color: #ef4444;
}

.btn.clear:hover {
    background-color: #f87171;
}

.btn.delete {
    background-color: #3f3f46;
}

.btn.delete:hover {
    background-color: #52525b;
}

.btn.equal {
    background-color: #10b981;
    grid-row: span 2;
}

.btn.equal:hover {
    background-color: #34d399;
}

.btn.zero {
    grid-column: span 2;
}
